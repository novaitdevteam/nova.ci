# Copy to .env (gitignored) and fill in, then start the CLI with `make claude`.
#
# .mcp.json reads these variables from the environment. Running `claude` directly
# without them leaves the outline and jira MCP servers unresolved -- they show as
# failed every session. Nothing else in the repo depends on this file.
outline_host=https://<outline-host>
outline_token=

jira_mcp=https://<jira-mcp-host>/mcp
jira_token=
